# NIPTEI Storefront — environment variables
# Copy to .env.local for local dev. NEVER commit .env.local or real keys.
# In Vercel: Project Settings > Environment Variables. Same names, same rule.
# NEXT_PUBLIC_ variables are visible in the browser. Server-only keys are not.

# Supabase project: https://cjatliwegffjsbyanbjk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://cjatliwegffjsbyanbjk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never in browser code, never in GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. OpenRouter API key for the AI Hair Helper / Content Studio.
# The key lives in Vercel env vars / the Secure Vault, never in code.
OPENROUTER_API_KEY=
# Model used by /api/ai-helper. Change in Vercel, not in code.
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
